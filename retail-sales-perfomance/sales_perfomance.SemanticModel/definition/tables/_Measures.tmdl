	measure 'First Sales Date' = ```
			
			CALCULATE (
			    MIN ( 'fact_sales'[Date] ),
			    FILTER ( 'fact_sales', [Total Sales] > 0 )
			)
			
			```
		formatString: General Date
		lineageTag: 5c841d5d-09c9-4f29-82cf-67eef4d52b66

	measure 'Projected YearEnd Sales' = ```
			
			VAR CutOffDate =
			    [Last Sales Date]                  -- end of last completed month
			VAR YearNum =
			    YEAR ( CutOffDate )
			VAR FirstSaleDate =
			    [First Sales Date]                 -- first non-zero sales date
			VAR MonthsElapsed =
			    DATEDIFF ( FirstSaleDate, CutOffDate, MONTH ) + 1
			VAR SalesToDate =
			    CALCULATE (
			        [Total Sales],
			        REMOVEFILTERS ( 'Calendar'[Month Name] ),          -- ignore Calendar slicers
			        REMOVEFILTERS ( 'fact_sales'[month] ),  -- ignore fact_sales Date slicers
			        KEEPFILTERS (
			            FILTER (
			                ALL ( 'Calendar' ),
			                YEAR ( 'Calendar'[Date] ) = YearNum &&
			                'Calendar'[Date] <= CutOffDate &&
			                'Calendar'[Date] >= FirstSaleDate
			            )
			        )
			    )
			VAR AvgMonthly =
			    IF ( MonthsElapsed > 0, DIVIDE ( SalesToDate, MonthsElapsed ), 0 )
			RETURN
			    SalesToDate + AvgMonthly * ( 12 - MonthsElapsed )
			
			```
		lineageTag: 1d98fe6b-d584-4939-9490-26b5197caceb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'MoM % Color' = ```
			
			VAR CurrMonth = SELECTEDVALUE ( 'Calendar'[Month Number] )
			VAR v = [MoM % calc]
			RETURN
			IF (
			    ISBLANK(CurrMonth) || CurrMonth = 1 || ISBLANK(v),
			    "#20e2d7",              -- grey for dash
			    IF ( v < 0,
			        "#FF0000",          -- red for negative
			        "#20e2d7"           -- teal for positive
			    )
			)
			
			```
		lineageTag: bc2fed48-939f-4397-b877-11270397b59d

	measure 'Branch Growth %' = ```
			
			VAR MinYM = MINX(ALLSELECTED('Calendar'), 'Calendar'[Month Number])
			VAR MaxYM = MAXX(ALLSELECTED('Calendar'), 'Calendar'[Month Number])
			VAR First = CALCULATE([Total Sales], FILTER(ALL('Calendar'), 'Calendar'[Month Number] = MinYM))
			VAR Last  = CALCULATE([Total Sales], FILTER(ALL('Calendar'), 'Calendar'[Month Number] = MaxYM))
			RETURN IF(First = 0, BLANK(), DIVIDE(Last - First, First, 0))
			
			```
		lineageTag: 3ff02d3c-0b65-4397-a0a6-3b620c19ce5e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Top 3 Branches Table' = ```
			
			TOPN (
			    3,
			    ADDCOLUMNS (
			        SUMMARIZE ( Branches, Branches[Branch] ),
			        "Sales", CALCULATE ( [Total Sales] )
			    ),
			    [Sales], DESC
			)
			
			```
		lineageTag: 981dad35-3224-42b3-bd0d-d62f71fecd6c

	measure 'Peak Month' = ```
			
			VAR Summary =
			  SUMMARIZE(
			    ALLSELECTED('Calendar'),
			    'Calendar'[Month Number],
			    'Calendar'[Month Name],
			    "MonthSales", CALCULATE([Total Sales])
			  )
			VAR Topmonth = TOPN(1, Summary, [MonthSales], DESC)
			RETURN MAXX(Topmonth, 'Calendar'[Month Name])
			
			```
		lineageTag: 81241aef-adee-46ae-8d14-01a048cb39fd

	measure 'Lowest Month' = ```
			
			VAR Summary =
			    SUMMARIZE(
			        FILTER(
			            ALLSELECTED('Calendar'),
			            [Total Sales] > 0   -- only months with actual sales
			        ),
			        'Calendar'[Year],
			        'Calendar'[Month Number],
			        'Calendar'[Month Name],
			        "MonthSales", [Total Sales]
			    )
			VAR Bot =
			    TOPN(1, Summary, [MonthSales], ASC)
			RETURN
			MAXX(Bot, 'Calendar'[Month Name])
			
			```
		lineageTag: 8c60aa11-68e8-43cb-9757-61bae97aef7e

	measure 'Peak Day' = ```
			
			VAR Summary =
			    SUMMARIZE(
			        FILTER(
			            ALLSELECTED('Calendar'),
			            [Total Sales] > 0   -- only include days that had sales
			        ),
			        'Calendar'[Weekday Name],
			        "DaySales", [Total Sales]
			    )
			VAR TopDay = TOPN(1, Summary, [DaySales], DESC)
			RETURN MAXX(TopDay, 'Calendar'[Weekday Name])
			
			```
		lineageTag: de0168d1-10c9-4485-a0a1-5f18b9a2a52f

