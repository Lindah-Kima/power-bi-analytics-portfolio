	measure BusyDayColor = ```
			
			VAR salesValue = [BusyDaySales]
			RETURN
			IF (
			    ISBLANK(salesValue),
			    BLANK(),   -- no color
			    IF (salesValue > 0, salesValue, 0)  -- keep your logic for red/blue
