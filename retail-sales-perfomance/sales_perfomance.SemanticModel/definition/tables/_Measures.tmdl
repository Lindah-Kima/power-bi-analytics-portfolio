table _Measures
	lineageTag: e8fd090c-208d-405c-b522-202af2abd98c

	measure 'Total Sales' = SUM(fact_sales[sales])
		formatString: 0
		lineageTag: dffeb94b-fdf5-4b0d-8372-d140a3c2df5f

	measure 'Avg Daily Sales' =
			
			DIVIDE ( [Total Sales], [Days Selected] )
		formatString: 0
		lineageTag: 0f3ffe5e-cc1b-4756-8138-c75058f4e168

	measure 'Sales per Branch' = DIVIDE([Total Sales], DISTINCTCOUNT(fact_sales[Branch]))
		lineageTag: 135fb1cf-5621-4c41-9a46-9be2a5326c0a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Prev Month Sales' = ```
			
			IF (
			    HASONEVALUE ( 'Calendar'[Month Name] ),
			    VAR PrevSales =
			        CALCULATE ( [Total Sales], DATEADD ( 'Calendar'[Date], -1, MONTH ) )
			    RETURN IF ( ISBLANK ( PrevSales ), "-", PrevSales ),
			    "-"   -- when no single month is selected
			)
			
			```
		lineageTag: 752c286f-bebb-4d7b-b29a-bf1ce4ea756f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales Growth %' = DIVIDE(([Total Sales] - [Prev Month Sales]), [Prev Month Sales])
		lineageTag: bca9ad6f-43d6-4cb6-8ca0-4d7b4babb9b6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales MTD' = ```
			TOTALMTD ( [Total Sales], Calendar[Date] )
			
			```
		formatString: 0
		lineageTag: 84006025-a484-4305-80d9-849bef40aad1

	measure 'Sales YTD' = TOTALYTD([Total Sales], 'MoM %'[Date])
		formatString: 0
		lineageTag: ebb791b3-8807-4315-88dd-86237ef94c5d

	measure 'Best Branch' = ```
			
			VAR t =
			    TOPN (
			        1,
			        SUMMARIZE ( ALL ( Branches[Branch] ), Branches[Branch], "S", [Total Sales] ),
			        [S], DESC
			    )
			RETURN CONCATENATEX ( t, Branches[Branch], ", " )
			
			```
		lineageTag: 97201c09-c3c7-465e-8c6f-3e03ff1631bc

	measure 'Branch Rank' = ```
			
			VAR CurrMonth = MAX('Calendar'[Month Number])
			VAR CurrYear  = MAX('Calendar'[Year])
			RETURN
			    RANKX(
			        FILTER(
			            ALL(fact_sales[Branch]),   -- only clear branch filter
			            CALCULATE(MAX('Calendar'[Month Number])) = CurrMonth &&
			            CALCULATE(MAX('Calendar'[Year])) = CurrYear
			        ),
			        [Sales per Branch],
			        ,
			        DESC,
			        DENSE
			    )
			
			```
		formatString: 0
		lineageTag: 1990c92d-d001-4b68-9228-cccab253de85

	measure 'Sales Forecast' = [Total Sales] * 1.05
		lineageTag: 5205b80e-a77f-4fc9-ba6b-c652610a36ff

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales Contribution %' = ```
			
			DIVIDE (
			    [Total Sales],
			    CALCULATE ( [Total Sales], ALL ( Branches[Branch] ) )
			)
			
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 82ed309d-c26f-48fc-9d4d-3e616aff0605

	measure 'MoM % calc' = ```
			
			VAR Curr = [Total Sales]
			VAR CurrMonth = MAX('Calendar'[Month Number])
			VAR Prev =
			    CALCULATE (
			        [Total Sales],
			        DATEADD ( 'Calendar'[Date], -1, MONTH )
			    )
			RETURN
			IF (
			    ISBLANK(CurrMonth) || CurrMonth = 1,
			    BLANK(),
			    DIVIDE ( Curr - Prev, Prev )
			)
			
			```
		lineageTag: 91de3972-ee11-473b-b350-066dc19de5ed

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Selected Month' = SELECTEDVALUE('Calendar'[Month Name], "All Months")
		lineageTag: c41a6253-f3dd-465a-9f46-0e2e2fdf2074

	measure 'Selected Branch' = SELECTEDVALUE(fact_sales[Branch], "All Branches")
