	partition Calendar = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS (
				    CALENDAR (DATE(2025,1,1), DATE(2025,12,31)),  -- adjust to cover your full data range
				    "Year", YEAR([Date]),
				    "Month Start", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ),
				    "Month Number", MONTH([Date]),
				    "Month Name", FORMAT([Date], "MMMM"),
				    "Year-Month", FORMAT([Date], "YYYY-MM"),
				    "Quarter", "Q" & FORMAT([Date], "Q"),
				    "Weekday Number", WEEKDAY([Date], 1),  -- 1 = Sunday as start of week
				    "Weekday Name", FORMAT([Date], "dddd"),
				    "Week Number", WEEKNUM([Date], 1)      -- 1 = Week starting on Sunday
				)
				
				```

	annotation PBI_Id = 2e21491decba43949df27790bffe792e

