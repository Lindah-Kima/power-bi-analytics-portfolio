model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-KE
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

/// individual tables before merge
queryGroup data

	annotation PBI_QueryGroupOrder = 0

annotation PBI_QueryOrder = ["KS1","KS2","KS3","KS4","KS5","ks1months","ks2months","ks3months","ks4months","ks5months","fact_sales","_Measures"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

ref table KS2
ref table KS1
ref table KS3
ref table KS4
ref table KS5
ref table ks1months
ref table ks2months
ref table ks3months
ref table ks4months
ref table ks5months
ref table fact_sales
ref table Branches
ref table _Measures
ref table Calendar
ref table BranchMonthSummary
ref table OrderBy

ref cultureInfo en-US

